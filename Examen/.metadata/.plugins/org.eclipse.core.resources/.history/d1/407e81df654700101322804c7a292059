#include <stdio.h>
#include "platform.h"
#include "xil_printf.h"
#include "AXI_NeoPixel.h"
#include "xparameters.h"
#include "xil_io.h"
#include "xgpio.h"

#define BTN_BASEADDR XPAR_AXI_GPIO_1_BASEADDR

void delay(int n) {
    for(int i = 0; i < n; i++);
}

int main()
{
    init_platform();

    print("Bowen Liang\n\r");

    for (int i = 0; i < 64; i++) {
        AXI_NEOPIXEL_mWriteReg(XPAR_AXI_NEOPIXEL_0_S00_AXI_BASEADDR, AXI_NEOPIXEL_S00_AXI_SLV_REG0_OFFSET + i * 4, 0x0000FF);
    }

    XGpio gpio;
    XGpio_Initialize(&gpio, XPAR_AXI_GPIO_1_DEVICE_ID);
    XGpio_SetDataDirection(&gpio, 1, 0xFFFFFFFF);

    int x = 0;
    int y = 0;

    while (1) {
        int btns = XGpio_DiscreteRead(&gpio, 2) & 0xF;

        if (btns & 0x01) {
            if (y > 0) y--;
        }
        if (btns & 0x02) {
            if (y < 6) y++;
        }
        if (btns & 0x04) {
            if (x > 0) x--;
        }
        if (btns & 0x08) {
            if (x < 6) x++;
        }

        for (int i = 0; i < 64; i++) {
            AXI_NEOPIXEL_mWriteReg(XPAR_AXI_NEOPIXEL_0_S00_AXI_BASEADDR, AXI_NEOPIXEL_S00_AXI_SLV_REG0_OFFSET + i * 4, 0x0000FF); // Blauw
        }

        for (int i = y; i < y + 2; i++) {
            for (int j = x; j < x + 2; j++) {
                int led_index = i * 8 + j;
                AXI_NEOPIXEL_mWriteReg(XPAR_AXI_NEOPIXEL_0_S00_AXI_BASEADDR, AXI_NEOPIXEL_S00_AXI_SLV_REG0_OFFSET + led_index * 4, 0xFF0000); // Groen
            }
        }

        while (XGpio_DiscreteRead(&gpio, 2) & 0xF);

        delay(500000);
    }

    cleanup_platform();
    return 0;
}
